{
  "app": "buggy-shop",
  "note": "BENCHMARK JUDGE ONLY. GhostQA exploration/oracle must never read this file.",
  "bugs": [
    {"id": "BUG-W1", "category": "state-dependent crash", "severity": "high",
     "desc": "购物车为空时点击立即支付，抛出未捕获异常",
     "kind": "js_error",
     "match": {"error_contains": "Cannot read properties of null"},
     "min_reproduction": ["cart.html: btn_remove", "cart.html: btn_checkout", "checkout.html: btn_pay"]},
    {"id": "BUG-W2", "category": "http 5xx", "severity": "high",
     "desc": "有商品时支付请求 /api/pay 始终返回 500",
     "kind": "http_error",
     "match": {"error_contains": "/api/pay"},
     "min_reproduction": ["cart.html: btn_checkout", "checkout.html: btn_pay"]},
    {"id": "BUG-W3", "category": "dead action", "severity": "medium",
     "desc": "收藏按钮点击无任何效果",
     "kind": "dead_action",
     "match": {"eid": "btn_fav"},
     "min_reproduction": ["products.html: item_apple", "detail.html: btn_fav"]},
    {"id": "BUG-W4", "category": "navigation loop", "severity": "medium",
     "desc": "帮助中心与更多帮助互相链接，无法退出",
     "kind": "nav_loop",
     "match": {"cycle_urls": ["/help.html", "/help2.html"]},
     "min_reproduction": ["products.html: nav_help", "help.html: btn_more", "help2.html: btn_back_help", "help.html: btn_more"]},
    {"id": "BUG-W5", "category": "state inconsistency", "severity": "high",
     "desc": "删除商品后购物车总价显示不更新",
     "kind": "semantic",
     "match": {"assert_id": "cart_total_consistent"},
     "min_reproduction": ["cart.html: btn_remove"]},
    {"id": "BUG-W6", "category": "form validation", "severity": "high",
     "desc": "用户名为空时也提示注册成功",
     "kind": "semantic",
     "match": {"assert_id": "register_requires_username"},
     "min_reproduction": ["register.html: reg_user=\"\"", "register.html: btn_reg"]},
    {"id": "BUG-W7", "category": "boundary", "severity": "medium",
     "desc": "库存可被扣为负数",
     "kind": "semantic",
     "match": {"assert_id": "stock_non_negative"},
     "min_reproduction": ["products.html: item_apple", "detail.html: btn_buy x3"]},
    {"id": "BUG-W8", "category": "boundary js error", "severity": "medium",
     "desc": "搜索关键词超过 20 字抛出未捕获 RangeError",
     "kind": "js_error",
     "match": {"error_contains": "搜索关键词过长"},
     "min_reproduction": ["index.html: search_box=25 chars", "index.html: search_btn"]},
    {"id": "BUG-W9", "category": "blank page", "severity": "medium",
     "desc": "活动专区页面渲染后完全空白",
     "kind": "blank",
     "match": {"url_contains": "/promo.html"},
     "min_reproduction": ["index.html: promo link"]},
    {"id": "BUG-W10", "category": "semantic spec violation", "severity": "high",
     "desc": "未登录也能看到个人中心内容（未跳转登录页）",
     "kind": "semantic",
     "match": {"assert_id": "login_gate"},
     "min_reproduction": ["index.html: 个人中心 link"]}
  ]
}
