      "trigger_depth": 4,
      "prerequisites": [],
      "match": {
        "error_contains": "/api/export"
      },
      "min_reproduction": [
        "index.html: nav_courses",
        "courses.html: open_row_c1",
        "course.html: nav_prefs",
        "settings.html: btn_export"
      ]
    },
    {
