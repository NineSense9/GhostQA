{
  "app": "buggy-campus",
  "note": "BENCHMARK JUDGE ONLY. GhostQA exploration must never read this file.",
  "bugs": [
    {
      "id": "BUG-CP1",
      "category": "blank page",
      "severity": "high",
      "desc": "列表架渲染后完全空白",
      "kind": "blank",
      "trigger_depth": 2,
      "prerequisites": [],
      "match": {
        "url_contains": "/modules.html"
      },
      "min_reproduction": [
        "index.html: nav_shelf"
      ]
    },
    {
      "id": "BUG-CP2",
      "category": "boundary js error",
      "severity": "medium",
      "desc": "首页检索词超过 24 字抛出未捕获异常",
      "kind": "js_error",
      "trigger_depth": 1,
      "prerequisites": [],
      "match": {
        "error_contains": "campus search query too long"
      },
      "min_reproduction": [
        "index.html: search_box=25 chars",
        "index.html: btn_query_submit"
      ]
    },
    {
      "id": "BUG-CP3",
      "category": "navigation loop",
      "severity": "medium",
      "desc": "说明页与相邻页互相链接",
      "kind": "nav_loop",
      "trigger_depth": 2,
      "prerequisites": [],
      "match": {
        "cycle_urls_contains": "help.html"
      },
      "min_reproduction": [
        "index.html: open_aid",
        "help.html: open_loop",
        "handbook.html: nav_up_help",
        "help.html: open_loop",
        "handbook.html: nav_up_help"
      ]
    },
    {
      "id": "BUG-CP4",
      "category": "form validation",
      "severity": "high",
      "desc": "标题为空时仍提示已创建",
      "kind": "semantic",
      "trigger_depth": 3,
      "prerequisites": [],
      "match": {
        "assert_id": "campus_title_required"
      },
      "min_reproduction": [
        "index.html: nav_courses",
        "courses.html: open_row_c1",
        "course.html: nav_prefs",
        "settings.html: btn_submit"
      ]
    },
    {
      "id": "BUG-CP5",
      "category": "dead action",
      "severity": "medium",
      "desc": "明细页收藏点击无效果",
      "kind": "dead_action",
      "trigger_depth": 3,
      "prerequisites": [],
      "match": {
        "eid": "btn_pin"
      },
      "min_reproduction": [
        "index.html: nav_courses",
        "courses.html: open_row_c1",
        "course.html: btn_pin"
      ]
    },
    {
      "id": "BUG-CP6",
      "category": "js error",
      "severity": "medium",
      "desc": "偏好页测试同步抛出未捕获异常",
      "kind": "js_error",
      "trigger_depth": 4,
      "prerequisites": [],
      "match": {
        "error_contains": "campus sync handshake failed"
      },
      "min_reproduction": [
        "index.html: nav_courses",
        "courses.html: open_row_c1",
        "course.html: nav_prefs",
        "settings.html: btn_probe"
      ]
    },
    {
      "id": "BUG-CP7",
      "category": "http 5xx",
      "severity": "high",
      "desc": "导出请求返回 500",
