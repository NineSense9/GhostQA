      "severity": "medium",
      "desc": "设置页测试同步抛出未捕获异常",
      "kind": "js_error",
      "trigger_depth": 2,
      "prerequisites": [],
      "match": {
        "error_contains": "crm sync handshake"
      },
      "min_reproduction": [
        "index.html: nav_settings",
        "settings.html: btn_test_sync"
      ]
    },
    {
      "id": "BUG-C2",
      "category": "blank page",
      "severity": "medium",
      "desc": "管道页渲染后完全空白",
      "kind": "blank",
      "trigger_depth": 1,
      "prerequisites": [],
      "match": {
        "url_contains": "/pipeline.html"
      },
      "min_reproduction": [
        "index.html: nav_pipeline"
      ]
    },
    {
      "id": "BUG-C3",
      "category": "dead action",
