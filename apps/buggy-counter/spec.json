{
  "app": "buggy-counter",
  "assertions": [
    {
      "id": "counter_title_required",
      "severity": "high",
      "desc": "标题为空时不应提示已创建",
      "when": {
        "url_contains": "/settings.html"
      },
      "assert": {
        "op": "implies",
        "cond": {
          "op": "eq",
          "left": {
            "obs": "input_topic_title"
          },
          "right": {
            "const": ""
          }
        },
        "then": {
          "op": "not_contains",
          "left": {
            "obs": "form_msg"
          },
          "right": {
            "const": "已创建"
          }
        }
      }
    },
    {
      "id": "counter_score_matches",
      "severity": "high",
      "desc": "展示分数应与记录分数一致",
      "when": {
        "url_contains": "/ticket.html"
      },
      "assert": {
        "op": "eq",
        "left": {
          "obs": "score_shown"
        },
        "right": {
          "obs": "score_live"
        }
      }
    }
  ]
}
