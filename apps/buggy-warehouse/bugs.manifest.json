{
  "app": "buggy-warehouse",
  "note": "BENCHMARK JUDGE ONLY. GhostQA exploration must never read this file.",
  "bugs": [
    {
      "id": "BUG-WH1",
      "category": "blank page",
      "severity": "high",
      "desc": "列表架渲染后完全空白",
      "kind": "blank",
      "trigger_depth": 2,
      "prerequisites": [],
      "match": {
        "url_contains": "/reports.html"
      },
      "min_reproduction": [
        "index.html: nav_rollup"
      ]
    },
    {
      "id": "BUG-WH2",
      "category": "boundary js error",
      "severity": "medium",
      "desc": "首页检索词超过 24 字抛出未捕获异常",
      "kind": "js_error",
      "trigger_depth": 1,
      "prerequisites": [],
      "match": {
        "error_contains": "warehouse search query too long"
      },
      "min_reproduction": [
        "index.html: search_box=25 chars",
        "index.html: btn_query_submit"
      ]
    },
    {
      "id": "BUG-WH3",
      "category": "navigation loop",
      "severity": "medium",
      "desc": "说明页与相邻页互相链接",
      "kind": "nav_loop",
      "trigger_depth": 2,
      "prerequisites": [],
      "match": {
        "cycle_urls_contains": "help.html"
      },
      "min_reproduction": [
        "index.html: open_aid",
        "help.html: open_loop",
        "settings.html: open_loop",
        "help.html: open_loop",
        "settings.html: open_loop"
      ]
    },
    {
      "id": "BUG-WH4",
      "category": "form validation",
      "severity": "high",
      "desc": "标题为空时仍提示已创建",
      "kind": "semantic",
      "trigger_depth": 3,
      "prerequisites": [],
      "match": {
        "assert_id": "warehouse_title_required"
      },
      "min_reproduction": [
        "index.html: nav_warehouses",
        "warehouses.html: open_row_w1",
        "warehouse.html: nav_prefs",
        "settings.html: btn_submit"
      ]
    },
    {
      "id": "BUG-WH5",
      "category": "dead action",
      "severity": "medium",
      "desc": "明细页收藏点击无效果",
      "kind": "dead_action",
      "trigger_depth": 3,
      "prerequisites": [],
      "match": {
        "eid": "btn_pin"
      },
      "min_reproduction": [
        "index.html: nav_warehouses",
        "warehouses.html: open_row_w1",
        "warehouse.html: btn_pin"
      ]
    },
    {
      "id": "BUG-WH6",
      "category": "js error",
      "severity": "medium",
      "desc": "偏好页测试同步抛出未捕获异常",
      "kind": "js_error",
      "trigger_depth": 4,
      "prerequisites": [],
      "match": {
        "error_contains": "warehouse sync handshake failed"
      },
      "min_reproduction": [
        "index.html: nav_warehouses",
        "warehouses.html: open_row_w1",
        "warehouse.html: nav_prefs",
        "settings.html: btn_probe"
      ]
    },
    {
      "id": "BUG-WH7",
      "category": "http 5xx",
      "severity": "high",
      "desc": "导出请求返回 500",
      "kind": "http_error",
      "trigger_depth": 4,
      "prerequisites": [],
      "match": {
        "error_contains": "/api/export"
      },
      "min_reproduction": [
        "index.html: nav_warehouses",
        "warehouses.html: open_row_w1",
        "warehouse.html: nav_prefs",
        "settings.html: btn_export"
      ]
    },
    {
      "id": "BUG-WH8",
      "category": "state inconsistency",
      "severity": "medium",
      "desc": "下调数量后展示值未更新",
      "kind": "semantic",
      "trigger_depth": 4,
      "prerequisites": [],
      "match": {
        "assert_id": "warehouse_qty_matches"
      },
      "min_reproduction": [
        "index.html: nav_warehouses",
        "warehouses.html: open_row_w1",
        "warehouse.html: btn_cool"
      ]
    },
    {
      "id": "BUG-WH9",
      "category": "cross-page consistency",
      "severity": "high",
      "desc": "内部摘记在相邻页显示为公开",
      "kind": "semantic",
      "trigger_depth": 5,
      "prerequisites": [],
      "match": {
        "assert_id": "warehouse_note_visibility"
      },
      "min_reproduction": [
        "index.html: nav_warehouses",
        "warehouses.html: open_row_w1",
        "warehouse.html: open_side",
        "items.html: open_side_i1",
        "item.html: btn_staff_note",
        "item.html: open_mid_b"
      ]
    },
    {
      "id": "BUG-WH10",
      "category": "sequence-dependent",
      "severity": "high",
      "desc": "关闭后再打开仍显示已关闭",
      "kind": "semantic",
      "trigger_depth": 6,
      "prerequisites": [],
      "match": {
        "assert_id": "warehouse_reopen_clears"
      },
      "min_reproduction": [
        "index.html: nav_warehouses",
        "warehouses.html: open_row_w1",
        "warehouse.html: open_mid",
        "zone.html: btn_close",
        "zone.html: btn_reopen",
        "zone.html: open_child_a"
      ]
    },
    {
      "id": "BUG-WH11",
      "category": "local action return",
      "severity": "high",
      "desc": "登记后的本地标记仍写着未登记",
      "kind": "semantic",
      "trigger_depth": 5,
      "prerequisites": [],
      "match": {
        "assert_id": "warehouse_handled_label"
      },
      "min_reproduction": [
        "index.html: nav_warehouses",
        "warehouses.html: open_row_w1",
        "warehouse.html: open_mid",
        "zone.html: open_child_a",
        "transfer.html: btn_mark"
      ]
    },
    {
      "id": "BUG-WH12",
      "category": "state inconsistency",
      "severity": "high",
      "desc": "分数展示与记录不一致",
      "kind": "semantic",
      "trigger_depth": 4,
      "prerequisites": [],
      "match": {
        "assert_id": "warehouse_score_matches"
      },
      "min_reproduction": [
        "index.html: nav_warehouses",
        "warehouses.html: open_finding"
      ]
    }
