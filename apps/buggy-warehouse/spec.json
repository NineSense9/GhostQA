{
  "app": "buggy-warehouse",
  "note": "Specification-driven semantic oracle. Uses ONLY page-presented values.",
  "assertions": [
    {
      "id": "warehouse_title_required",
      "severity": "high",
      "desc": "标题为空时不应提示已创建",
      "when": {
        "url_contains": "/settings.html"
      },
      "assert": {
        "op": "implies",
        "cond": {
          "op": "eq",
          "left": {
            "obs": "input_topic_title"
          },
          "right": {
            "const": ""
          }
        },
        "then": {
          "op": "not_contains",
          "left": {
            "obs": "form_msg"
          },
          "right": {
            "const": "已创建"
          }
        }
      }
    },
    {
      "id": "warehouse_qty_matches",
      "severity": "medium",
      "desc": "展示数量应与剩余数量一致",
      "when": {
        "url_contains": "/warehouse.html"
      },
      "assert": {
        "op": "eq",
        "left": {
          "obs": "shown_qty"
        },
        "right": {
          "obs": "live_qty"
        }
      }
    },
    {
      "id": "warehouse_reopen_clears",
      "severity": "high",
      "desc": "重新打开后不应仍显示已关闭",
      "when": {
        "url_contains": "/transfer.html"
      },
      "assert": {
        "op": "implies",
        "cond": {
          "op": "eq",
          "left": {
            "obs": "reopened"
          },
          "right": {
            "const": "是"
          }
        },
        "then": {
          "op": "ne",
          "left": {
            "obs": "status_label"
          },
          "right": {
            "const": "已关闭"
          }
        }
      }
    },
    {
      "id": "warehouse_note_visibility",
      "severity": "high",
      "desc": "内部摘记不应显示为公开",
      "when": {
        "url_contains": "/batch.html"
      },
      "assert": {
        "op": "implies",
        "cond": {
          "op": "eq",
          "left": {
            "obs": "note_kind"
          },
          "right": {
            "const": "内部"
          }
        },
        "then": {
          "op": "eq",
          "left": {
            "obs": "note_visible"
          },
          "right": {
            "const": "内部"
          }
        }
      }
    },
    {
      "id": "warehouse_handled_label",
      "severity": "high",
      "desc": "登记之后标记不应仍是未登记",
      "when": {
        "url_contains": "/transfer.html"
      },
      "assert": {
        "op": "implies",
        "cond": {
          "op": "eq",
          "left": {
            "obs": "handled"
          },
          "right": {
            "const": "是"
          }
        },
        "then": {
          "op": "eq",
          "left": {
            "obs": "handled_label"
          },
          "right": {
            "const": "已登记"
          }
        }
      }
    },
    {
      "id": "warehouse_score_matches",
      "severity": "high",
      "desc": "展示分数应与记录分数一致",
      "when": {
        "url_contains": "/inspection.html"
      },
      "assert": {
        "op": "eq",
        "left": {
          "obs": "score_shown"
        },
        "right": {
          "obs": "score_live"
        }
      }
    }
  ]
}
