{
  "app": "buggy-kiosk",
  "note": "BENCHMARK JUDGE ONLY. GhostQA exploration must never read this file.",
  "bugs": [
    {
      "id": "BUG-KS1",
      "category": "boundary js error",
      "severity": "medium",
      "desc": "首页检索词超过 24 字抛出未捕获异常",
      "kind": "js_error",
      "trigger_depth": 1,
      "prerequisites": [],
      "match": {
        "error_contains": "kiosk search query too long"
      },
      "min_reproduction": [
        "index.html: search_box=25 chars",
        "index.html: btn_query_submit"
      ]
    },
    {
      "id": "BUG-KS2",
      "category": "navigation loop",
      "severity": "medium",
      "desc": "说明与偏好互相链接",
      "kind": "nav_loop",
      "trigger_depth": 2,
      "prerequisites": [],
      "match": {
        "cycle_urls_contains": "help.html"
      },
      "min_reproduction": [
        "index.html: open_aid",
        "help.html: open_loop",
        "settings.html: open_loop",
        "help.html: open_loop",
        "settings.html: open_loop"
      ]
    },
    {
      "id": "BUG-KS3",
      "category": "form validation",
      "severity": "high",
      "desc": "标题为空时仍提示已创建",
      "kind": "semantic",
      "trigger_depth": 2,
      "prerequisites": [],
      "match": {
        "assert_id": "kiosk_title_required"
      },
      "min_reproduction": [
        "index.html: open_aid",
        "help.html: open_loop",
        "settings.html: btn_submit"
      ]
    },
    {
      "id": "BUG-KS4",
      "category": "dead action",
      "severity": "medium",
      "desc": "保存草稿点击无效果",
      "kind": "dead_action",
      "trigger_depth": 2,
      "prerequisites": [],
      "match": {
        "eid": "btn_pin"
      },
      "min_reproduction": [
        "index.html: open_aid",
        "help.html: open_loop",
        "settings.html: btn_pin"
      ]
    },
    {
      "id": "BUG-KS5",
      "category": "js error",
      "severity": "medium",
      "desc": "偏好页同步抛出未捕获异常",
      "kind": "js_error",
      "trigger_depth": 2,
      "prerequisites": [],
      "match": {
        "error_contains": "kiosk sync handshake failed"
      },
      "min_reproduction": [
        "index.html: open_aid",
        "help.html: open_loop",
        "settings.html: btn_probe"
      ]
    },
    {
      "id": "BUG-KS6",
      "category": "http 5xx",
      "severity": "high",
      "desc": "导出请求返回 500",
      "kind": "http_error",
      "trigger_depth": 3,
      "prerequisites": [],
      "match": {
        "error_contains": "/api/export"
      },
      "min_reproduction": [
        "index.html: open_aid",
        "help.html: open_loop",
        "settings.html: btn_export"
      ]
    },
    {
      "id": "BUG-KS7",
      "category": "state inconsistency",
      "severity": "high",
      "desc": "任务分数展示与记录不一致",
      "kind": "semantic",
      "trigger_depth": 2,
      "prerequisites": [],
      "match": {
        "assert_id": "kiosk_score_matches"
      },
      "min_reproduction": [
        "index.html: nav_kiosk",
        "kiosk.html: open_task_t1"
      ]
    },
    {
      "id": "BUG-KS8",
      "category": "local mutation",
      "severity": "high",
      "desc": "只记一笔时另一标记被要求相同",
      "kind": "semantic",
      "trigger_depth": 3,
      "prerequisites": [],
      "match": {
        "assert_id": "kiosk_note_label"
      },
      "min_reproduction": [
        "index.html: nav_kiosk",
        "kiosk.html: open_task_t2",
        "task.html: btn_note_a"
      ]
    }
  ]
}
