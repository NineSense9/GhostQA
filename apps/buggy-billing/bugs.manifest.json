{
  "app": "buggy-billing",
  "note": "BENCHMARK JUDGE ONLY. GhostQA exploration/oracle must never read this file.",
  "bugs": [
    {
      "id": "BUG-B1",
      "category": "blank page",
      "severity": "high",
      "desc": "收款列表渲染后完全空白",
      "kind": "blank",
      "trigger_depth": 2,
      "prerequisites": [],
      "match": {
        "url_contains": "/payments.html"
      },
      "min_reproduction": [
        "index.html: nav_accounts",
        "accounts.html: nav_payments"
      ]
    },
    {
      "id": "BUG-B2",
      "category": "boundary js error",
      "severity": "medium",
      "desc": "首页检索词超过 24 字抛出未捕获异常",
      "kind": "js_error",
      "trigger_depth": 1,
      "prerequisites": [],
      "match": {
        "error_contains": "billing search query too long"
      },
      "min_reproduction": [
        "index.html: search_box=25 chars",
        "index.html: btn_query_submit"
      ]
    },
    {
      "id": "BUG-B3",
      "category": "navigation loop",
      "severity": "medium",
      "desc": "说明与手册互相链接",
      "kind": "nav_loop",
      "trigger_depth": 2,
      "prerequisites": [],
      "match": {
        "cycle_urls_contains": "help.html"
      },
      "min_reproduction": [
        "index.html: nav_help",
        "help.html: open_handbook",
        "handbook.html: nav_up_help",
        "help.html: open_handbook",
        "handbook.html: nav_up_help"
      ]
    },
    {
      "id": "BUG-B4",
      "category": "form validation",
      "severity": "high",
      "desc": "标题为空时仍提示已创建",
      "kind": "semantic",
      "trigger_depth": 3,
      "prerequisites": [],
      "match": {
        "assert_id": "billing_title_required"
      },
      "min_reproduction": [
        "index.html: nav_accounts",
        "accounts.html: nav_compose",
        "compose.html: btn_submit"
      ]
    },
    {
      "id": "BUG-B5",
      "category": "dead action",
      "severity": "medium",
      "desc": "账户收藏点击无效果",
      "kind": "dead_action",
      "trigger_depth": 3,
      "prerequisites": [],
      "match": {
        "eid": "btn_pin"
      },
      "min_reproduction": [
        "index.html: nav_accounts",
        "accounts.html: open_acct_a1",
        "account.html: btn_pin"
      ]
    },
    {
      "id": "BUG-B6",
      "category": "js error",
      "severity": "medium",
      "desc": "偏好页测试同步抛出未捕获异常",
      "kind": "js_error",
      "trigger_depth": 4,
      "prerequisites": [],
      "match": {
        "error_contains": "billing sync handshake failed"
      },
      "min_reproduction": [
        "index.html: nav_accounts",
        "accounts.html: open_acct_a1",
        "account.html: nav_prefs",
        "settings.html: btn_probe"
      ]
    },
    {
      "id": "BUG-B7",
      "category": "http 5xx",
      "severity": "high",
      "desc": "导出请求返回 500",
      "kind": "http_error",
      "trigger_depth": 4,
      "prerequisites": [],
      "match": {
        "error_contains": "/api/export"
      },
      "min_reproduction": [
        "index.html: nav_accounts",
        "accounts.html: open_acct_a1",
        "account.html: nav_prefs",
        "settings.html: btn_export"
      ]
    },
    {
      "id": "BUG-B8",
      "category": "state inconsistency",
      "severity": "medium",
      "desc": "下调费用后展示值未更新",
      "kind": "semantic",
      "trigger_depth": 4,
      "prerequisites": [],
      "match": {
        "assert_id": "billing_fee_matches"
      },
      "min_reproduction": [
        "index.html: nav_accounts",
        "accounts.html: open_acct_a1",
        "account.html: open_bill_i1",
        "invoice.html: btn_adjust"
      ]
    },
    {
      "id": "BUG-B9",
      "category": "sequence-dependent",
      "severity": "high",
      "desc": "关闭后再打开仍显示已关闭",
      "kind": "semantic",
      "trigger_depth": 6,
      "prerequisites": [],
      "match": {
        "assert_id": "billing_reopen_clears"
      },
      "min_reproduction": [
        "index.html: nav_accounts",
        "accounts.html: open_acct_a1",
        "account.html: open_bill_i1",
        "invoice.html: open_credit",
        "credits.html: btn_close",
        "credits.html: btn_reopen"
      ]
    },
    {
      "id": "BUG-B10",
      "category": "cross-page consistency",
      "severity": "high",
      "desc": "内部记录在抵扣页显示为公开",
      "kind": "semantic",
      "trigger_depth": 5,
      "prerequisites": [],
      "match": {
        "assert_id": "billing_note_visibility"
      },
      "min_reproduction": [
        "index.html: nav_accounts",
        "accounts.html: open_acct_a1",
        "account.html: open_bill_i1",
        "invoice.html: btn_staff_note",
        "invoice.html: open_credit"
      ]
    }
  ]
}
