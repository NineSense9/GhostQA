{
  "app": "buggy-flow",
  "note": "Specification-driven semantic oracle. Uses ONLY page-presented values (data-obs / input values) - never internal app state. GhostQA must never read bugs.manifest.json.",
  "assertions": [
    {"id": "register_requires_username", "severity": "high",
     "desc": "用户名为空时不应提示注册成功",
     "when": {"url_contains": "/register"},
     "assert": {"op": "implies",
                "cond": {"op": "eq", "left": {"obs": "input_reg_user"}, "right": {"const": ""}},
                "then": {"op": "not_contains", "left": {"obs": "form_msg"},
                         "right": {"const": "成功"}}}},
    {"id": "project_name_required", "severity": "high",
     "desc": "已创建的项目名称不应为空",
     "when": {"url_contains": "/project"},
     "assert": {"op": "ne", "left": {"obs": "project_name"}, "right": {"const": ""}}},
    {"id": "archived_guest_cannot_edit", "severity": "high",
     "desc": "已归档项目中访客不应能编辑",
     "when": {"url_contains": "/project"},
     "assert": {"op": "implies",
                "cond": {"op": "eq", "left": {"obs": "archive_state"}, "right": {"const": "已归档"}},
                "then": {"op": "ne", "left": {"obs": "guest_can_edit"}, "right": {"const": "true"}}}},
    {"id": "reopen_clears_done", "severity": "medium",
     "desc": "任务重新打开后状态不应仍为已完成",
     "when": {"url_contains": "/tasks"},
     "assert": {"op": "implies",
                "cond": {"op": "eq", "left": {"obs": "task_reopened"}, "right": {"const": "true"}},
                "then": {"op": "ne", "left": {"obs": "task_status"}, "right": {"const": "已完成"}}}},
    {"id": "coupon_price_consistent", "severity": "high",
     "desc": "账单显示价格应与数量和优惠计算一致",
     "when": {"url_contains": "/billing"},
     "assert": {"op": "eq", "left": {"obs": "bill_price"}, "right": {"obs": "bill_price_expected"}}},
    {"id": "member_count_consistent", "severity": "medium",
     "desc": "成员计数应与列表人数一致",
     "when": {"url_contains": "/members"},
     "assert": {"op": "eq", "left": {"obs": "member_count"}, "right": {"obs": "member_count_real"}}},
    {"id": "dashboard_name_matches", "severity": "medium",
     "desc": "工作台展示的项目名应与项目真实名称一致",
     "when": {"url_contains": "/dashboard"},
     "assert": {"op": "eq", "left": {"obs": "dash_project_name"}, "right": {"obs": "real_project_name"}}},
    {"id": "login_gate_dashboard", "severity": "high",
     "desc": "未登录不应看到工作台内容",
     "when": {"url_contains": "/dashboard"},
     "assert": {"op": "not_contains", "left": {"obs": "login_state"},
                "right": {"const": "未登录"}}},
    {"id": "bill_qty_non_negative", "severity": "medium",
     "desc": "账单数量不应为负数（holdout）",
     "when": {"url_contains": "/billing"},
     "assert": {"op": "ge", "left": {"obs": "bill_qty"}, "right": {"const": 0}}}
  ]
}
