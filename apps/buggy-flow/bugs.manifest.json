{
  "app": "buggy-flow",
  "note": "BENCHMARK JUDGE ONLY. GhostQA exploration/oracle must never read this file. Frozen at the benchmark freeze commit; do not move bugs to make Ghost win.",
  "bugs": [
    {"id": "BUG-D1", "category": "js error", "severity": "medium",
     "desc": "关于页点击版本信息抛出未捕获异常",
     "kind": "js_error", "trigger_depth": 2, "prerequisites": [],
     "match": {"error_contains": "version info"}},
    {"id": "BUG-D2", "category": "blank page", "severity": "medium",
     "desc": "报表页渲染后完全空白",
     "kind": "blank", "trigger_depth": 2, "prerequisites": [],
     "match": {"url_contains": "/reports.html"}},
    {"id": "BUG-D3", "category": "dead action", "severity": "medium",
     "desc": "系统设置的保存按钮点击无任何效果",
     "kind": "dead_action", "trigger_depth": 2, "prerequisites": [],
     "match": {"eid": "btn_save_settings"}},
    {"id": "BUG-D4", "category": "form validation", "severity": "high",
     "desc": "用户名为空时也提示注册成功",
     "kind": "semantic", "trigger_depth": 3, "prerequisites": [],
     "match": {"assert_id": "register_requires_username"}},
    {"id": "BUG-D5", "category": "boundary js error", "severity": "medium",
     "desc": "项目名称超过 20 字抛出未捕获 RangeError",
     "kind": "js_error", "trigger_depth": 4, "prerequisites": ["login"],
     "match": {"error_contains": "项目名过长"}},
    {"id": "BUG-D6", "category": "form validation", "severity": "high",
     "desc": "空项目名仍可创建成功",
     "kind": "semantic", "trigger_depth": 6, "prerequisites": ["login", "wizard"],
     "match": {"assert_id": "project_name_required"}},
    {"id": "BUG-D7", "category": "http 5xx", "severity": "high",
     "desc": "导出账单请求 /api/export 始终返回 500",
     "kind": "http_error", "trigger_depth": 7, "prerequisites": ["login", "project"],
     "match": {"error_contains": "/api/export"}},
    {"id": "BUG-D8", "category": "navigation loop", "severity": "medium",
     "desc": "帮助中心与文档互相链接，无法退出",
     "kind": "nav_loop", "trigger_depth": 3, "prerequisites": [],
     "match": {"cycle_urls_contains": "help.html"}},
    {"id": "BUG-D9", "category": "state-dependent semantic", "severity": "high",
     "desc": "归档后访客仍可编辑项目",
     "kind": "semantic", "trigger_depth": 12, "prerequisites": ["login", "project", "member", "guest", "archive"],
     "match": {"assert_id": "archived_guest_cannot_edit"}},
    {"id": "BUG-D10", "category": "sequence-dependent", "severity": "medium",
     "desc": "任务重新打开后状态仍为已完成",
     "kind": "semantic", "trigger_depth": 10, "prerequisites": ["login", "project", "task", "complete", "reopen"],
     "match": {"assert_id": "reopen_clears_done"}},
    {"id": "BUG-D11", "category": "cross-page consistency", "severity": "high",
     "desc": "修改数量后优惠价格未重算",
     "kind": "semantic", "trigger_depth": 9, "prerequisites": ["login", "project", "coupon", "qty"],
     "match": {"assert_id": "coupon_price_consistent"}},
    {"id": "BUG-D12", "category": "state inconsistency", "severity": "medium",
     "desc": "移除成员后计数未更新",
     "kind": "semantic", "trigger_depth": 9, "prerequisites": ["login", "project", "add-member", "remove"],
     "match": {"assert_id": "member_count_consistent"}},
    {"id": "BUG-D13", "category": "sequence-dependent crash", "severity": "high",
     "desc": "取消归档后再删除项目抛出未捕获异常",
     "kind": "js_error", "trigger_depth": 9, "prerequisites": ["login", "project", "archive", "unarchive"],
     "match": {"error_contains": "delete after unarchive"}},
    {"id": "BUG-D14", "category": "cross-page consistency", "severity": "medium",
     "desc": "重命名后工作台仍显示旧项目名",
     "kind": "semantic", "trigger_depth": 8, "prerequisites": ["login", "project", "rename"],
     "match": {"assert_id": "dashboard_name_matches"}}
  ]
}
